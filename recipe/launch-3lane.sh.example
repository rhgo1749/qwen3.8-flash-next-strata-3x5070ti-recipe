#!/usr/bin/env bash
# Qwen3.8-Flash-Next / Strata / 3x RTX 5070 Ti
#
# Current promoted implementation pin (Strata 0.1.24):
#   rhgo1749/Strata@3824f04003b79609a7cc6861ea5b4652a47d2ddb
# Integration merge:
#   rhgo1749/Strata@82a51614517392f2c5b83af7c39ffbb7abbc783e
#
# This is a host-specific example for the validated GPU enumeration:
#   GPU0 = PCIe 5.0 x8
#   GPU1 = PCIe 5.0 x4
#   GPU2 = PCIe 5.0 x8
#
# Verify your own topology before copying the asymmetric pcie-frac values.
# Strata 0.1.24 adaptive hot-expert replacement is enabled by default;
# add --adapt-swaps 0 to the underlying engine args only for a static-residency A/B.

STRATA_DIR="${STRATA_DIR:-$HOME/Strata}"
CONFIG="${CONFIG:-/absolute/path/to/strata.json}"
PUBLIC_PORT="${PUBLIC_PORT:-18086}"

cd "$STRATA_DIR"

exec python serve/multigpu_server.py \
  --config "$CONFIG" \
  --gpus 0,1,2 \
  --lane-contexts 262144,262144,262144 \
  --kv-budget 786432 \
  --lane-cpu-cores 5,6,5 \
  --lane-pcie-fracs 0.55,0.25,0.55 \
  --lane-kv-residents 32768,32768,32768 \
  --port "$PUBLIC_PORT"
